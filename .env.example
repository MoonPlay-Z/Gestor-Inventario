# ─── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# TRUST_PROXY=1  # set to 'true' or number if behind reverse proxy

# ─── B2B API ──────────────────────────────────────────────────────────────────
B2B_API_KEY="your-b2b-api-key-here"

# ─── Company defaults ─────────────────────────────────────────────────────────
EMPRESA_NOMBRE="Mi Empresa C.A."
EMPRESA_RIF="J-00000000-0"
EMPRESA_DIRECCION=""
EMPRESA_TELEFONO=""
EMPRESA_EMAIL=""

# ─── Currency ─────────────────────────────────────────────────────────────────
MONEDA_SIMBOLO="$"
MONEDA_CODIGO="USD"

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"

# ─── Database provider (optional) ─────────────────────────────────────────────
# DB_PROVIDER=sqlite  # uncomment to use SQLite instead of PostgreSQL

# ─── Electron ─────────────────────────────────────────────────────────────────
# ELECTRON_ENV=true  # uncomment for Electron mode
