{
  "name": "gestor-inventario-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "cap:add": "cap add android && cap add ios",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "build:capacitor": "vite build --mode capacitor && cap sync",
    "build:android": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug build",
    "test": "node --test src/features/actualizaciones/domain",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/preferences": "^6.0.4",
    "@iconify/icons-mdi": "^1.2.48",
    "@iconify/react": "^6.0.2",
    "@zxing/library": "^0.21.3",
    "chart.js": "^4.4.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.4",
    "typescript": "^7.0.2",
    "vite": "^5.4.11"
  }
}
