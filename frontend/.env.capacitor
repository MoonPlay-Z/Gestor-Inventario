# URL del backend para la app nativa (Capacitor).
#
# Producción (HTTPS, certificado válido → sin avisos y cámara habilitada):
VITE_API_URL=https://gestor-inventario-qamm.onrender.com/api

# Origen del sitio donde se publican la APK y el manifiesto de actualizaciones
# (/descargas/version.json). En la app nativa no sirve una ruta relativa: el
# WebView resolvería contra el dist empaquetado y vería la versión vieja.
VITE_UPDATE_URL=https://gestor-pos.netlify.app

# Desarrollo en la red local (sin cable). Si el router cambia la IP, actualizar:
# VITE_API_URL=http://192.168.0.140:3001/api

# Desarrollo con cable USB (adb reverse tcp:3001 tcp:3001):
# VITE_API_URL=http://localhost:3001/api
