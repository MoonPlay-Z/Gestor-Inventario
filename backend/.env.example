# Configuración del entorno
# Copia este archivo como .env y ajusta los valores

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_inventario?schema=public"

# Puerto del servidor
PORT=3001

# Nombre de la empresa (aparece en facturas)
EMPRESA_NOMBRE="Mi Empresa C.A."
EMPRESA_RIF="J-12345678-9"
EMPRESA_DIRECCION="Av. Principal, Local 1, Caracas, Venezuela"
EMPRESA_TELEFONO="+58 212-555-0100"
EMPRESA_EMAIL="info@miempresa.com"

# Símbolo de moneda
MONEDA_SIMBOLO="Bs."
MONEDA_CODIGO="VES"
