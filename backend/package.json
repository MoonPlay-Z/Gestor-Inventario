{
  "name": "gestor-inventario-backend",
  "version": "1.0.0",
  "description": "Backend para sistema de gestión de inventario, facturación y pagos",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:sqlite:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:sqlite:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:migrate:sqlite": "node scripts/migrar-postgresql-a-sqlite.js",
    "db:verify:sqlite": "node scripts/verificar-integridad-sqlite.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "setup": "npm install && npx prisma generate && npx prisma migrate dev --name init && node prisma/seed.js",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "verify": "node scripts/verificar-request-id-facturas.js",
    "prisma_validate": "prisma validate",
    "test:rutas": "node ../scripts/auditar-rutas-express.js",
    "test:unidades": "node scripts/test-invariante-venta-por-peso.js",
    "test:integridad": "node scripts/verificar-integridad-bd.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "serialport": "^13.0.0",
    "serverless-http": "^4.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "typescript-eslint": "^8.71.2"
  }
}
