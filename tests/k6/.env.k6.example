# Configuración local del arnés k6. Copia a .env.k6 y ajusta.
# NUNCA apuntes DATABASE_URL a producción.

BASE_URL=http://localhost:3001

# PostgreSQL efímero (recomendado):
#   docker run --rm -d --name pos-test-pg \
#     -e POSTGRES_PASSWORD=test -e POSTGRES_DB=pos_test \
#     -p 5433:5432 postgres:16
DATABASE_URL=postgresql://postgres:test@localhost:5433/pos_test

# Debe coincidir exactamente con el JWT_SECRET del backend.
JWT_SECRET=test-secret

# Obligatorio para reset/seed: el arnés borra y recrea datos.
ALLOW_DESTRUCTIVE_TESTS=true

# Desactiva el job diario de tasa para que no salga a internet durante las pruebas.
TASA_DOLAR_AUTO_UPDATE=false
